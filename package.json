{
  "name": "notescam-saas",
  "private": true,
  "version": "0.3.15",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:lan": "vite build --mode lan",
    "server": "node server/index.js",
    "lan": "npm run build:lan && node server/index.js",
    "lan:dev": "node server/index.js",
    "test": "node scripts/run-tests.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:sync-batch": "node --experimental-loader ./src/lib/_syncBatch.hooks.mjs src/lib/_syncBatch.test.mjs",
    "test:teacher-import": "node --experimental-loader ./src/lib/_teacherImport.hooks.mjs src/lib/_teacherImport.test.mjs",
    "test:my-profile": "node server/_my_profile.test.mjs",
    "perf:engines": "node --experimental-loader ./scripts/lib/esm-resolve.mjs scripts/perf-engines.mjs",
    "perf:selectors": "node --experimental-loader ./scripts/lib/esm-resolve.mjs scripts/perf-selectors.mjs",
    "perf:network": "node scripts/perf-network.mjs",
    "perf:bundle": "node scripts/perf-bundle.mjs",
    "test:print": "node --experimental-loader ./scripts/lib/esm-resolve.mjs scripts/test-print.mjs",
    "test:print:capacity": "node --experimental-loader ./scripts/lib/esm-resolve.mjs scripts/print-capacity.mjs",
    "test:print:perf": "node --experimental-loader ./scripts/lib/esm-resolve.mjs scripts/print-bench.mjs",
    "validate": "node scripts/validate-sync.mjs",
    "validate:full": "node scripts/validate-sync.mjs --full",
    "validate:migrations": "node scripts/validate-migrations.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "import:sqlite": "node scripts/sqlite-to-pivot.mjs",
    "import:csv": "node scripts/csv-to-pivot.mjs",
    "license": "node packaging/license/make-license.mjs",
    "reset:password": "node server/reset-password-cli.mjs",
    "seed:ecole": "node packaging/make-seed-ecole.mjs",
    "video": "remotion studio remotion/index.jsx",
    "video:render": "remotion render remotion/index.jsx",
    "video:record": "node remotion/recorder/record-demos.mjs",
    "test:bilingue": "node src/core/_bilEngine.test.mjs && node --experimental-loader ./scripts/lib/esm-resolve.mjs src/lib/_bilAutoConfig.test.mjs && node server/_bilSeed.test.mjs && node server/_bulletinAccess.test.mjs && node server/_bulletinSecurityE2E.test.mjs",
    "demo:bilingue": "node --experimental-loader ./scripts/lib/esm-resolve.mjs scripts/demo-bilingue-bulletins.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fastify/static": "^7.0.4",
    "@supabase/supabase-js": "^2.39.0",
    "fastify": "^4.29.1",
    "framer-motion": "^12.40.0",
    "html-to-image": "^1.11.13",
    "html2canvas": "^1.4.1",
    "jspdf": "^2.5.2",
    "jsqr": "^1.4.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.7.284",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "xlsx": "^0.18.5",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@remotion/cli": "^4.0.471",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.20",
    "playwright": "^1.60.0",
    "postcss": "^8.4.41",
    "remotion": "^4.0.471",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.10",
    "vite": "^5.4.0",
    "vite-plugin-pwa": "^1.3.0"
  }
}
